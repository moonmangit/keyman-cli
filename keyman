#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: ./keyman <command> [arguments]. Run ./keyman --help for commands.
' >&2
  exit 1
}

if ! command -v wsl.exe >/dev/null 2>&1; then
  printf 'Error: WSL is required for this Git Bash launcher.\n' >&2
  exit 1
fi

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
linux_binary="$repo_dir/target/release/keyman"
if [[ ! -f "$linux_binary" ]]; then
  printf 'Error: Rust binary is missing. Build it in Ubuntu WSL with cargo build --release.\n' >&2
  exit 1
fi

to_wsl_path() {
  local windows_path
  windows_path="$(cygpath -m -- "$1")"
  MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu -- wslpath -u "$windows_path" | tr -d '\r'
}

wsl_binary="$(to_wsl_path "$linux_binary")"
wsl_home="$(to_wsl_path "$HOME")"

[[ $# -ge 1 ]] || usage
args=("$@")
# Translate the path arguments; other commands pass through unchanged and
# run in the current directory, which WSL maps automatically.
case "$1" in
  load|init)
    [[ $# -eq 2 && "$2" != -* ]] && args[1]="$(to_wsl_path "$2")"
    ;;
  inject|save|diff)
    [[ $# -eq 3 && "$3" != -* ]] && args[2]="$(to_wsl_path "$3")"
    ;;
esac
MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu -- env "HOME=$wsl_home" "$wsl_binary" "${args[@]}"
